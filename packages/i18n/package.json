{
  "name": "@cafebot/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Internacionalización de Cafebot con Paraglide.js",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "type-check": "tsgo -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('src/paraglide', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.23.1"
  }
}
